# GitHub Actions Self-Hosted Runner — Environment Configuration
#
# Copy this file to .env and fill in your values.
#
# IMPORTANT: GitHub App credentials are NOT in this file. They live as files
# in /etc/github-app/ on the host (root:0400). See README "Place the App
# credentials on the host" for the exact setup steps. The runner container
# never reads the App key — only the registrar sidecar does, and only at
# token-mint time.

# =============================================================================
# REQUIRED: Roku Device Configuration
# =============================================================================

# IP address of your Roku test device (REQUIRED - no default)
# This is the only local device the runner can reach (iptables-enforced).
# The runner will fail to start if this is not set.
ROKU_DEVICE_IP=YOUR_ROKU_IP_HERE

# =============================================================================
# OPTIONAL: Runner Configuration
# =============================================================================

# Runner name (defaults to roku-runner-01 if not set).
# Use generic names like roku-runner-01, roku-runner-02 to avoid leaking
# hostnames to GitHub's runner UI.
RUNNER_NAME=roku-runner-01

# Runner labels (comma-separated, defaults to: self-hosted,roku,roku-device)
RUNNER_LABELS=self-hosted,roku,roku-device

# Timezone (defaults to America/New_York)
TIMEZONE=America/New_York

# =============================================================================
# OPTIONAL: Monitoring
# =============================================================================

# Healthchecks.io push URL for runner liveness. If set, runner-entrypoint.sh
# pings <URL>/start at boot and <URL> every 60s while the container is alive.
# Configure the HC check with period=1m and grace=5m so brief gaps between
# ephemeral job cycles don't false-alert. Wire HC's integrations (Gotify,
# email, etc.) to alert on missed pings. Leave unset to disable.
#
# Why this exists: a deprecated runner binary, a crash loop, or a hung
# container won't emit pings — HC.io alerts after the grace period.
# HEALTHCHECKS_URL=https://hc-ping.com/<your-runner-uuid>
