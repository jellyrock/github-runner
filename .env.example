# GitHub Actions Self-Hosted Runner Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: GitHub App Authentication
# =============================================================================
# Create a GitHub App in your organization settings:
# 1. Go to Settings > Developer settings > GitHub Apps > New GitHub App
# 2. Name: jellyrock-runner (or any name)
# 3. Homepage URL: https://github.com/jellyrock
# 4. Disable Webhook
# 5. Permissions needed:
#    - Actions: Read & Write
#    - Administration: Read & Write  
#    - Contents: Read & Write
#    - Metadata: Read-only
#    - Pull requests: Read & Write
# 6. Create app, then generate a private key
# 7. Install the app on your repository
# 8. Note the App ID and Installation ID from the URLs

GITHUB_APP_ID=YOUR_APP_ID_HERE
GITHUB_APP_INSTALL_ID=YOUR_INSTALL_ID_HERE

# Private key content - paste the entire key including BEGIN/END lines
# Replace newlines with \n or keep as multi-line
GITHUB_APP_PEM="-----BEGIN RSA PRIVATE KEY-----
YOUR_PRIVATE_KEY_CONTENT_HERE
-----END RSA PRIVATE KEY-----"

# =============================================================================
# OPTIONAL: Runner Configuration
# =============================================================================

# Runner name (defaults to roku-runner-01 if not set)
# Use generic names like roku-runner-01, roku-runner-02 to avoid exposing hostname
RUNNER_NAME=roku-runner-01

# Runner labels (comma-separated, defaults to: self-hosted,roku,roku-device)
RUNNER_LABELS=self-hosted,roku,roku-device

# Timezone (defaults to America/New_York)
TIMEZONE=America/New_York

# =============================================================================
# REQUIRED: Roku Device Configuration
# =============================================================================

# IP address of your Roku test device (REQUIRED - no default)
# This is the only local device the runner can access
# The runner will fail to start if this is not set
ROKU_DEVICE_IP=YOUR_ROKU_IP_HERE
